#!/usr/bin/env python3
"""rtfm launcher: prefer `uv run`, else a self-managed venv. Deps come from the
server's PEP-723 block so there is one source of truth (ADR 0009)."""
import hashlib
import os
import re
import shutil
import subprocess
import sys
import venv
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SERVER = ROOT / "rtfm_server.py"


def parse_pep723_deps(server: Path) -> list[str]:
    # The repo files are UTF-8 by contract; the server module's docstring
    # carries em-dashes, and a locale read under an ASCII locale would break
    # the launch (the FATAL handler below reports it, but the venv fallback
    # would fail entirely).
    text = server.read_text(encoding="utf-8")
    block = re.search(r"# /// script\n(.*?)# ///", text, re.S)
    if not block:
        return []
    # Strip PEP-723 comment prefix ("# " or "#") from each line before parsing
    content = re.sub(r"^# ?", "", block.group(1), flags=re.MULTILINE)
    # Anchor the closing bracket to start-of-line so "mcp[cli]" doesn't terminate early
    dep_block = re.search(r"dependencies = \[(.*?)^\]", content, re.S | re.MULTILINE)
    if not dep_block:
        return []
    return re.findall(r'"([^"]+)"', dep_block.group(1))


def _corpus_home() -> Path:
    return Path(os.environ.get("RTFM_HOME", Path.home() / ".rtfm")).expanduser()


def run_with_venv() -> None:
    deps = parse_pep723_deps(SERVER)
    vdir = _corpus_home() / "venv"
    py = vdir / "bin" / "python"
    stamp = vdir / ".deps"
    key = hashlib.sha256("\n".join(sorted(deps)).encode()).hexdigest()[:12]
    if not py.exists():
        vdir.parent.mkdir(parents=True, exist_ok=True)
        venv.create(vdir, with_pip=True)
    if not stamp.exists() or stamp.read_text() != key:
        subprocess.check_call([str(py), "-m", "pip", "install", "--quiet", *deps])
        stamp.write_text(key)
    os.execv(str(py), [str(py), str(SERVER)])


def main() -> None:
    if shutil.which("uv"):
        os.execvp("uv", ["uv", "run", str(SERVER)])
    try:
        run_with_venv()
    except Exception as e:  # loud, actionable; never a silent hang
        sys.stderr.write(
            f"[rtfm] FATAL: could not start the server: {e}\n"
            f"[rtfm] Install `uv` (https://docs.astral.sh/uv/) for the fast path, "
            f"or ensure python3 + pip work.\n"
        )
        sys.exit(1)


if __name__ == "__main__":
    main()
