#!/usr/bin/env python3
"""rtfm launcher: prefer `uv run`, else a self-managed venv.

Dependencies come from pyproject.toml (the single source of truth). The venv
path installs the project editable, so `python -m rtfm_server` runs the same
code and entry point as the published package.
"""
import hashlib
import os
import shutil
import subprocess
import sys
import tomllib
import venv
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SERVER = ROOT / "rtfm_server.py"


def project_deps(root: Path) -> list[str]:
    data = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8"))
    return list(data["project"]["dependencies"])


def deps_stamp(deps: list[str]) -> str:
    return hashlib.sha256("\n".join(sorted(deps)).encode()).hexdigest()[:12]


def _corpus_home() -> Path:
    return Path(os.environ.get("RTFM_HOME", Path.home() / ".rtfm")).expanduser()


def run_with_venv() -> None:
    deps = project_deps(ROOT)
    vdir = _corpus_home() / "venv"
    py = vdir / "bin" / "python"
    stamp = vdir / ".deps"
    key = deps_stamp(deps)
    if not py.exists():
        vdir.parent.mkdir(parents=True, exist_ok=True)
        venv.create(vdir, with_pip=True)
    if not stamp.exists() or stamp.read_text(encoding="utf-8") != key:
        subprocess.check_call(
            [
                str(py),
                "-m",
                "pip",
                "install",
                "--quiet",
                "--disable-pip-version-check",
                "-e",
                str(ROOT),
            ],
            stdout=sys.stderr,
        )
        stamp.write_text(key, encoding="utf-8")
    os.execv(str(py), [str(py), "-m", "rtfm_server"])


def main() -> None:
    if shutil.which("uv"):
        os.execvp("uv", ["uv", "run", str(SERVER)])
    try:
        run_with_venv()
    except Exception as e:  # loud, actionable; never a silent hang
        sys.stderr.write(
            f"[rtfm] FATAL: could not start the server: {e}\n"
            f"[rtfm] Install `uv` (https://docs.astral.sh/uv/) for the fast path, "
            f"or ensure python3 + pip work.\n"
        )
        sys.exit(1)


if __name__ == "__main__":
    main()
